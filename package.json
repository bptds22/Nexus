{
  "name": "nexus-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "cross-env NEXT_DIST_DIR=.next-web next dev -p 3000",
    "prebuild": "node scripts/check-css-literals.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:css": "node scripts/check-css-literals.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "mobile:sync": "npm run build:mobile && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:run:android": "npm run mobile:sync && npx cap run android",
    "dev:mobile": "cross-env NEXT_PUBLIC_CAPACITOR_BUILD=true NEXT_DIST_DIR=.next-mobile next dev -H 0.0.0.0 -p 3001",
    "cap:dev": "npx cap run android --live-reload --host 10.0.2.2 --port 3001"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.3.30",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@ebarooni/capacitor-calendar": "^8.2.0",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.100.1",
    "@tanstack/query-sync-storage-persister": "^5.100.14",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@tanstack/react-query-persist-client": "^5.100.14",
    "firebase": "^12.15.0",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
