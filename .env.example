# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (10 products — test mode)
STRIPE_PRICE_RECRUTEUR_PRO_MONTHLY=price_...
STRIPE_PRICE_RECRUTEUR_PRO_ANNUAL=price_...
STRIPE_PRICE_RECRUTEUR_ALLSTAR_MONTHLY=price_...
STRIPE_PRICE_RECRUTEUR_ALLSTAR_ANNUAL=price_...
STRIPE_PRICE_COACH_PRO_MONTHLY=price_...
STRIPE_PRICE_COACH_PRO_ANNUAL=price_...
STRIPE_PRICE_COACH_ALLSTAR_MONTHLY=price_...
STRIPE_PRICE_COACH_ALLSTAR_ANNUAL=price_...
STRIPE_PRICE_ATHLETE_PRO_MONTHLY=price_...
STRIPE_PRICE_ATHLETE_PRO_ANNUAL=price_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Courriel partenaire — secret partagé avec l'edge function
# send-partner-welcome (header x-partner-welcome-secret). Doit être IDENTIQUE
# à la valeur posée côté Supabase (secrets des edge functions). La clé Resend
# elle-même (RESEND_API_KEY) vit uniquement côté edge function, jamais ici.
PARTNER_WELCOME_SECRET=

# Fond de carte — MapTiler (recherche CÉGEP, page de programme)
# Carto a rendu sa clé obligatoire : ses tuiles publiques reviennent avec un
# filigrane « API KEY REQUIRED » cuit dans l'image. Le fond est passé à
# MapTiler (styles dataviz-dark et dataviz).
# NEXT_PUBLIC_ = inlinée dans le bundle navigateur, donc PUBLIQUE par nature :
# une clé de tuiles doit l'être. Ce qui la protège est la RESTRICTION PAR
# DOMAINE à poser dans le tableau de bord MapTiler, pas le secret.
# Sans cette variable, le fond de carte ne charge pas (403) et la carte reste
# vide — MapPane journalise un avertissement.
NEXT_PUBLIC_MAPTILER_KEY=

# Meta Pixel + Conversions API (publicités Meta, optimisation sur inscriptions)
# Rien ne part chez Meta sans le cookie nexus_consent=granted (bandeau
# « Accepter »), ni dans le build Capacitor. Aucune donnée personnelle
# n'est envoyée — voir lib/meta/regles.ts.
# ID du pixel : public par nature (NEXT_PUBLIC_, inliné dans le bundle).
# Vide = pixel, bandeau et lien « Gérer les témoins » entièrement désactivés.
NEXT_PUBLIC_META_PIXEL_ID=
# Jeton Conversions API — SERVEUR SEULEMENT, jamais NEXT_PUBLIC_.
# Events Manager → pixel → Paramètres → Conversions API → Générer un jeton.
META_CAPI_TOKEN=
# Optionnel, TESTS seulement : code « Événements test » d'Events Manager.
# Le retirer en prod, sinon les vrais événements restent en mode test.
META_TEST_EVENT_CODE=
