<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Barres système fixes = background app #111317 (PAS d'edge-to-edge :
             le contenu reste au-dessus). windowLight*Bar=false → glyphes clairs
             sur fond sombre. navigationBarColor peint la nav bar du bas (aucun
             plugin requis pour une couleur fixe). -->
        <item name="android:statusBarColor">#111317</item>
        <item name="android:navigationBarColor">#111317</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <!-- Iter 7.55 — Splash window Android 12+ (AndroidX Theme.SplashScreen,
         rétrocompatible jusqu'à API 23 via compat lib).

         windowSplashScreenBackground = fond plein #111317 (match React).
         windowSplashScreenAnimatedIcon = vector NON-adaptive (drawable simple)
           → Android 12+ ne masque PAS en cercle (= clé pour supprimer le
           cercle blanc du splash actuel).
         postSplashScreenTheme = thème après dismissal (l'app continue avec).
         windowSplashScreenAnimationDuration = 250ms, sync avec
           SplashScreen.hide({fadeOutDuration: 250}) côté React.

         ⚠️ AUCUN windowSplashScreenIconBackgroundColor → pas de cercle de
           fond derrière l'icône.
         ⚠️ android:background retiré (n'était pas reconnu par Theme.SplashScreen
           de toute façon — le splash.png legacy reste inutilisé). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- Barres système #111317 DÈS le splash → zéro flash blanc avant que
             le JS (StatusBarBootstrap) ne s'exécute. -->
        <item name="android:statusBarColor">#111317</item>
        <item name="android:navigationBarColor">#111317</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>