<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- windowLight*Bar=false → glyphes CLAIRS (heure, batterie, pilule de
             geste) sur fond sombre. Ces deux-là comptent encore. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- ⚠️ statusBarColor / navigationBarColor sont DÉPRÉCIÉS ET IGNORÉS
             depuis targetSdk 35+ : Android impose l'edge-to-edge et rend les
             deux barres TRANSPARENTES. Ils sont conservés ci-dessous pour les
             appareils plus anciens, où ils peignent encore.

             Sur Android 15/16, ce qui transparaît sous les barres n'est donc
             plus leur couleur : c'est le FOND DE FENÊTRE. Or les parents
             AppCompat *.Light.* et *.DayNight le posent CLAIR — d'où les deux
             bandes blanches, en haut et en bas, observées sur un écran par
             ailleurs sombre (recette 2026-09-10). Le déclarer explicitement est
             le seul réglage qui agisse encore sur les deux plateformes. -->
        <item name="android:windowBackground">#111317</item>
        <item name="android:colorBackground">#111317</item>
        <item name="android:statusBarColor">#111317</item>
        <item name="android:navigationBarColor">#111317</item>
    </style>


    <!-- Iter 7.55 — Splash window Android 12+ (AndroidX Theme.SplashScreen,
         rétrocompatible jusqu'à API 23 via compat lib).

         windowSplashScreenBackground = fond plein #111317 (match React).
         windowSplashScreenAnimatedIcon = vector NON-adaptive (drawable simple)
           → Android 12+ ne masque PAS en cercle (= clé pour supprimer le
           cercle blanc du splash actuel).
         postSplashScreenTheme = thème après dismissal (l'app continue avec).
         windowSplashScreenAnimationDuration = 250ms, sync avec
           SplashScreen.hide({fadeOutDuration: 250}) côté React.

         ⚠️ AUCUN windowSplashScreenIconBackgroundColor → pas de cercle de
           fond derrière l'icône.
         ⚠️ android:background retiré (n'était pas reconnu par Theme.SplashScreen
           de toute façon — le splash.png legacy reste inutilisé). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- Barres système #111317 DÈS le splash → zéro flash blanc avant que
             le JS (StatusBarBootstrap) ne s'exécute. -->
        <item name="android:statusBarColor">#111317</item>
        <item name="android:navigationBarColor">#111317</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>